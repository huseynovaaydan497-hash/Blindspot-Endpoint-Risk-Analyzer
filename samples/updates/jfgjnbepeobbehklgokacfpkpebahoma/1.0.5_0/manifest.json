{
  "manifest_version": 3,
  "name": "Corp SSO Helper",
  "version": "1.0.5",
  "description": "Internal single sign-on helper (example).",
  "permissions": [
    "nativeMessaging",
    "identity",
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://*.corp.example.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  }
}
