{
  "manifest_version": 3,
  "name": "Quick Translate",
  "version": "1.9.1",
  "description": "Translate the selected text.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
