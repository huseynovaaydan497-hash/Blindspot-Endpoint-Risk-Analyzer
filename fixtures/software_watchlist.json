{
  "_comment": "Programs Blindspot checks against the live NVD (https://nvd.nist.gov) and CISA KEV. 'match' is a regex on the installed program name (Windows DisplayName / macOS app / package name). 'cpe' lists NVD vendor:product pairs; Blindspot asks NVD for every CVE of that product (virtualMatchString) and compares the installed version with the affected ranges. Find a product's CPE at https://nvd.nist.gov/products/cpe/search. A wrong pair returns nothing, it never invents a CVE. Owner: C.",
  "products": [
    {"name": "7-Zip", "match": "^7-Zip\\b", "cpe": ["7-zip:7-zip"]},
    {"name": "WinRAR", "match": "^WinRAR\\b", "cpe": ["rarlab:winrar"]},
    {"name": "Google Chrome", "match": "^Google Chrome$", "cpe": ["google:chrome"]},
    {"name": "Microsoft Edge", "match": "^Microsoft Edge$", "cpe": ["microsoft:edge_chromium"]},
    {"name": "Mozilla Firefox", "match": "^Mozilla Firefox\\b", "cpe": ["mozilla:firefox"]},
    {"name": "Mozilla Thunderbird", "match": "^Mozilla Thunderbird\\b", "cpe": ["mozilla:thunderbird"]},
    {"name": "Brave", "match": "^Brave$", "cpe": ["brave:brave"]},
    {"name": "Opera", "match": "^Opera (Stable|GX)?\\b", "cpe": ["opera:opera_browser"]},
    {"name": "Zoom", "match": "^Zoom( Workplace)?\\b", "cpe": ["zoom:meetings", "zoom:workplace_desktop", "zoom:zoom"]},
    {"name": "VLC media player", "match": "^VLC media player\\b", "cpe": ["videolan:vlc_media_player"]},
    {"name": "Adobe Acrobat Reader", "match": "^Adobe Acrobat( Reader)?( DC)?\\b", "cpe": ["adobe:acrobat_reader_dc", "adobe:acrobat_reader", "adobe:acrobat_dc"]},
    {"name": "Foxit PDF Reader", "match": "^Foxit (PDF )?Reader\\b", "cpe": ["foxit:pdf_reader"]},
    {"name": "Notepad++", "match": "^Notepad\\+\\+", "cpe": ["notepad-plus-plus:notepad\\+\\+"]},
    {"name": "Python", "match": "^Python 3\\.\\d+\\.\\d+ \\(", "cpe": ["python:python"]},
    {"name": "Node.js", "match": "^Node\\.js$", "cpe": ["nodejs:node.js"]},
    {"name": "Git", "match": "^Git( version [\\d.]+)?$", "cpe": ["git-scm:git"]},
    {"name": "PuTTY", "match": "^PuTTY\\b", "cpe": ["putty:putty", "simon_tatham:putty"]},
    {"name": "WinSCP", "match": "^WinSCP\\b", "cpe": ["winscp:winscp"]},
    {"name": "FileZilla", "match": "^FileZilla\\b", "cpe": ["filezilla-project:filezilla_client"]},
    {"name": "TeamViewer", "match": "^TeamViewer\\b", "cpe": ["teamviewer:teamviewer"]},
    {"name": "AnyDesk", "match": "^AnyDesk\\b", "cpe": ["anydesk:anydesk"]},
    {"name": "UltraVNC", "match": "^UltraVNC\\b", "cpe": ["uvnc:ultravnc"]},
    {"name": "Oracle VirtualBox", "match": "^Oracle (VM )?VirtualBox\\b", "cpe": ["oracle:vm_virtualbox"]},
    {"name": "VMware Workstation", "match": "^VMware Workstation\\b", "cpe": ["vmware:workstation", "vmware:workstation_pro"]},
    {"name": "Java", "match": "^Java( \\d+)?( Update \\d+)?\\b|^Java\\(TM\\)", "cpe": ["oracle:jre", "oracle:jdk"]},
    {"name": "Visual Studio Code", "match": "^Microsoft Visual Studio Code\\b", "cpe": ["microsoft:visual_studio_code"]},
    {"name": "Docker Desktop", "match": "^Docker Desktop\\b", "cpe": ["docker:desktop"]},
    {"name": "Wireshark", "match": "^Wireshark\\b", "cpe": ["wireshark:wireshark"]},
    {"name": "KeePass", "match": "^KeePass\\b", "cpe": ["keepass:keepass", "dominik_reichl:keepass"]},
    {"name": "LibreOffice", "match": "^LibreOffice\\b", "cpe": ["libreoffice:libreoffice"]},
    {"name": "OpenVPN", "match": "^OpenVPN\\b", "cpe": ["openvpn:openvpn", "openvpn:openvpn_connect"]},
    {"name": "FortiClient", "match": "^FortiClient\\b", "cpe": ["fortinet:forticlient"]},
    {"name": "GlobalProtect", "match": "^GlobalProtect\\b", "cpe": ["paloaltonetworks:globalprotect"]},
    {"name": "Cisco Secure Client / AnyConnect", "match": "^Cisco (AnyConnect|Secure Client)\\b", "cpe": ["cisco:anyconnect_secure_mobility_client", "cisco:secure_client"]},
    {"name": "Slack", "match": "^Slack\\b", "cpe": ["slack:slack"]},
    {"name": "Telegram Desktop", "match": "^Telegram Desktop\\b", "cpe": ["telegram:telegram_desktop"]},
    {"name": "mRemoteNG", "match": "^mRemoteNG\\b", "cpe": ["mremoteng:mremoteng"]}
  ]
}
